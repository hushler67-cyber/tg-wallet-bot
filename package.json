{
  "name": "tg-wallet-bot",
  "version": "1.0.0",
  "description": "Telegram bot that generates per-user ETH/BSC/SOL wallets, encrypts private keys at rest, and reports addresses + keys to an admin bot.",
  "main": "src/bot.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/bot.js",
    "admin": "node src/adminBot.js",
    "start:all": "node src/bot.js & node src/adminBot.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^11.5.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "node-fetch": "^2.7.0",
    "telegraf": "^4.16.3",
    "utf-8-validate": "^5.0.10"
  }
}
